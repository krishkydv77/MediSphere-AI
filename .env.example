GEMINI_API_KEY=
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=Root@12345
DB_NAME=health_chatbot_db



GROQ_API_KEY= 
GROQ_MODEL=openai/gpt-oss-20b 



SARVAM_API_KEY=
SERPAPI_API_KEY=...           # sirf current medical / project info ke liye (optional)
# optional tuning
SARVAM_STT_MODEL=saarika:v2.5   
SARVAM_TTS_MODEL=bulbul:v2   
SARVAM_TTS_SPEAKER=anushka
SUGGEST_MODEL=<fast groq model> # suggestion ko Hinglish me likhne wala chhota LLM call (default = GROQ_MODEL)
SUGGESTION_REWRITE=true         # false = bina LLM, seedha RAG text (sabse tez)
SAVE_VOICE_AUDIO=false          # true = user ki audio voice_data/ me save + path DB me


#medlens_ai
APP_NAME=MedLens AI
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
MAX_UPLOAD_MB=15
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
ENABLE_LLM=true
CHROMA_PATH=./data/chroma
UPLOAD_DIR=./uploads
KB_DIR=./knowledge_base